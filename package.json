  "type": "module",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "dev": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.esm.mjs && node dist/server.esm.mjs",

    "start": "node dist/server.esm.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "setup:mongodb": "node setup-mongodb.js",
    "test:mongodb": "node test-mongodb-connection.js",
    "db:test": "node test-mongodb-connection.js"
  },
